---
import BaseHead from '../components/BaseHead.astro';
import PortfolioLanding from '../components/PortfolioLanding';
import '../styles/landing.css';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = allPosts.slice(0, 5).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  cover: post.data.heroImage ? post.data.heroImage.src : undefined,
  url: `/blog/${post.id}/`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Mtende Kuyokwa — Software Engineer"
      description="Portfolio of Mtende Kuyokwa. Software engineer building Jiya and Katholic — projects, experience, and writing."
    />
    <meta property="og:title" content="Mtende Kuyokwa — Software Engineer" />
    <meta property="og:description" content="Projects, experience, and writing from Mtende Kuyokwa." />
  </head>
  <body class="landing">
    <PortfolioLanding client:load posts={posts} />
  </body>
</html>
